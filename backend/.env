# Server configuration
PORT=8085
ENV=development

# Database - MySQL primary choice
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USER=abc_user
DB_PASSWORD=v12345
DB_NAME=abc_user_management

# MongoDB alternative
MONGO_URI=mongodb://localhost:27017/abc_users

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ for event-driven architecture
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Admin default credentials
ADMIN_EMAIL=admin@abc.com
ADMIN_PASSWORD=Admin@123456