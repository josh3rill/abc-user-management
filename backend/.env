# Server configuration
PORT=8085
ENV=development

# Database - MySQL primary choice
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USER=abc_user
DB_PASSWORD=v12345
DB_NAME=abc_user_management # Ensure this database exists in your MySQL server
DB_SYNCHRONIZE=true
DB_LOGGING=true # Enable query logging for debugging

# MongoDB alternative
MONGO_URI=mongodb://localhost:27017/abc_users

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Redis Cache
REDIS_HOST=redis  # Use 'localhost' if Redis is running locally
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ for event-driven architecture
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672/

# Admin default credentials
ADMIN_EMAIL=admin@abc.com
ADMIN_PASSWORD=Admin@123456